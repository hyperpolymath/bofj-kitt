# ECOSYSTEM.a2ml — Ecosystem position
# Converted from ECOSYSTEM.scm on 2026-04-14

[metadata]
project = "bofj-kitt"
ecosystem = "hyperpolymath"

[position]
type = "tooling"
purpose = "Shared Developer Environment Extension Kit (the SuperChainsaw) for the BoJ (Box of Justice) server — provisions and extends estate-compliant developer environments and registers them with the BoJ MCP gateway."

[pipeline]
position = "developer-tooling"
chain = "developer environment → bofj-kitt → BoJ server (MCP gateway)"
notes = "bofj-kitt provisions an estate-compliant dev environment, wires in the RSR session protocols, and registers it with a BoJ server via the Groove service-discovery manifest."
coordination = "boj-server"

[related-projects]
projects = [
  { name = "boj-server", relationship = "host/consumer", notes = "The BoJ (Box of Justice) MCP gateway this kit extends and registers with. See .github/workflows/boj-build.yml." },
  { name = "rsr-template-repo", relationship = "lineage", notes = "The RSR scaffold this repository was created from (2026-03-16)." },
  { name = "standards", relationship = "governance", notes = "Estate-wide reusable CI workflows and session-management standards." },
]
