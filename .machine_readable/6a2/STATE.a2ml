#
# STATE.a2ml — Project state checkpoint
#
# This is the STATE file for bofj-kitt.

[metadata]
project = "bofj-kitt"
version = "0.3.0"
last-updated = "2026-07-16"
status = "active"  # active | paused | archived

[project-context]
name = "bofj-kitt"
purpose = "Shared Developer Environment Extension Kit (the SuperChainsaw) for the BoJ (Box of Justice) server — provisions and extends estate-compliant developer environments and registers them with the BoJ MCP gateway."
completion-percentage = 5

[position]
phase = "design"           # design | implementation | testing | maintenance | archived
maturity = "experimental"  # experimental | alpha | beta | production | lts

[route-to-mvp]
milestones = [
  { name = "M0: Truthful identity + green governance CI + committed assessment/roadmap", completion = 90 },
  { name = "M1: Finish placeholder-token fills; restore full SECURITY policy; curate template docs", completion = 0 },
  { name = "M2: Product spec — define an 'extension'; kit artifact list; BoJ integration contract", completion = 0 },
  { name = "M3: Choose implementation language; re-add real e2e workflow", completion = 0 },
  { name = "M4: First shippable kit artifact + per-capability tests (CRG D)", completion = 0 },
  { name = "M5: Live BoJ-server integration + dogfooding (CRG C -> B)", completion = 0 },
]

[blockers-and-issues]
# Blocked on product definition (M2): testing and language choice cannot begin
# until the kit's first capability is specified.

[critical-next-actions]
actions = [
  "M1 — fill the remaining ~75 placeholder-token files (container/, .devcontainer/, .github/*)",
  "M1 — restore a full SECURITY policy once PGP material exists",
  "M2 — specify the kit's first capability and its BoJ integration contract",
]

[maintenance-status]
last-run-utc = "never"
last-report = "docs/reports/maintenance/latest.json"
last-result = "unknown"  # unknown | pass | warn | fail
open-warnings = 0
open-failures = 0

[ecosystem]
part-of = ["BoJ (Box of Justice) ecosystem", "RSR Framework"]
depends-on = ["boj-server"]
