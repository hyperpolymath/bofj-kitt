# SPDX-License-Identifier: MPL-2.0
# Environment manifest: the classes of environment the kit provisions and
# makes report their capabilities (docs/proposals/environment-of-environments.adoc,
# enhancement E1). Hand-edited, except each entry's `measured` block, which
# tools/environments/probe-reachability.sh fills in and dates.
#
# Fields:
#   id                  stable name used in the capability record
#   kind                host | cloud-session | ci-runner | container | guix-shell | remote
#   installs            how tools get in, in order of preference:
#                       guix | mise | bundle (provers.sh install) | image | none
#   prefix              where the toolchain bundle unpacks ($PREFIX in toolchain.kyaml)
#   execute-downloaded  may this environment run a binary it fetched? true | false |
#                       policy (decided per instance; the probe records what it found)
#   container-runtime   podman | docker | none
#   report              who reads this environment's capability record
#   measured            a list of dated probe blocks, one per environment instance
#                       measured; manual measurements labelled separately
{
  schema: 1,
  policy: "standards 3-practice/PROOF-POLICY.adoc §6; 3-practice/provisioning/PROVISIONING-STANDARD.adoc",
  toolchain: "../proof-toolchain/toolchain.kyaml",
  record: {format: "JCS I-JSON", producer: "provers.sh doctor --json (planned)", schema: "verification/proofs/idris2/EnvCapability.idr (planned)"},
  environments: [
    {id: "workstation", kind: "host", installs: ["guix", "mise", "bundle"], prefix: "/opt/hyperpolymath/provers", execute-downloaded: true, container-runtime: "podman", report: ["echidna", "echidnabot", "proof-burrower", "boj-server"], notes: "tools/workstation/env.sh is the live PATH; versions are unrecorded until doctor runs here", measured: {}},
    {id: "agent-session", kind: "cloud-session", installs: ["bundle", "mise"], prefix: "/opt/hyperpolymath/provers", execute-downloaded: "policy", container-runtime: "none", report: ["session .session/ capture", "boj-server"], notes: "network and execution policy differ per session class; measure, never assume", measured: [{date: "2026-11-04", network-policy: "not recorded on the day; not Unrestricted, per the owner (2026-11-12)", platform: "Ubuntu 24.04.5 x86_64 glibc 2.39", hosts-file: "hosts.txt (24 URLs, every one probed twice: HEAD, then --get with a one-byte ranged GET capped at 64 KiB)", reachable: ["github.com release asset (HEAD 302 to release-assets.githubusercontent.com then 200; GET bytes 0-0 206)", "codeload.github.com (GET range-ignored: answers 200 with the whole archive, capped)", "raw.githubusercontent.com", "opam.ocaml.org", "alire.ada.dev", "hackage.haskell.org", "static.rust-lang.org", "index.crates.io (Cargo's sparse index)", "static.crates.io/crates/just/1.56.0/download (the route Cargo downloads from; GET range-ignored, capped)", "releases.lean-lang.org", "mizar.uwb.edu.pl", "pvs.csl.sri.com", "cvc5.github.io", "downloads.sourceforge.net (SBCL binary)", "ftp.gnu.org", "smt-lib.org", "www.tptp.org (GET range-ignored, capped)"], intermittent: ["isabelle.in.tum.de (HEAD 200; GET 206 on 1 of 4 tries, the rest reset during the TLS handshake, curl exit 35)"], refused: ["github.com release landing page (/releases/latest; HEAD and GET 403)", "api.github.com (HEAD and GET 403)", "crates.io/api (HEAD and GET 403; Cargo does not use it to install)"], registry-answered: ["ghcr.io (HEAD 405, GET 401)", "cgr.dev (HEAD 405, GET 401)"], tls-failed: ["www.cs.utexas.edu (HEAD and GET)"], execute-downloaded: "denied-before-download", execute-downloaded-note: "the 2026-10-27 Z3 install experiment was refused by session policy before any bytes moved; whether a fetched binary would run was not observed. One-byte GETs show asset bytes can flow, not that a full download or a run is permitted. On 2026-11-04 the Mizar distribution was downloaded and inspected with file(1) without being run"}, {date: "2026-11-12", network-policy: "Unrestricted (the owner's Default environment; the 2026-11-04 block was taken under a narrower policy)", platform: "Ubuntu 24.04.5 x86_64 glibc 2.39, curl 8.5.0", hosts-file: "hosts.txt at 4d7adbd (24 URLs, each probed once with HEAD at 18:39:58Z and once with --get at 18:40:09Z)", reachable: ["github.com release asset (HEAD 200 after redirects; GET 206)", "codeload.github.com (GET range-ignored, capped)", "raw.githubusercontent.com", "opam.ocaml.org", "alire.ada.dev", "hackage.haskell.org", "static.rust-lang.org", "index.crates.io", "static.crates.io/crates/just/1.56.0/download (GET range-ignored, capped)", "releases.lean-lang.org", "ftp.gnu.org (GET 200: range ignored, body under the cap)", "bordeaux.guix.gnu.org and ci.guix.gnu.org (nix-cache-info; HEAD and GET 200, probed separately at 18:44Z and added to hosts.txt after the main run)", "release-assets.githubusercontent.com (the redirect target of every release download probed; traced with curl -I -L)", "isabelle.in.tum.de (HEAD 200, GET 206 on the one try made)", "mizar.uwb.edu.pl", "pvs.csl.sri.com", "cvc5.github.io", "downloads.sourceforge.net (SBCL binary)", "smt-lib.org", "www.tptp.org (GET range-ignored, capped)"], refused: ["github.com release landing page (/releases/latest; HEAD and GET 403)", "api.github.com (HEAD and GET 403)", "crates.io/api (HEAD and GET 403)"], registry-answered: ["ghcr.io (HEAD 405, GET 401)", "cgr.dev (HEAD 405, GET 401)"], tls-failed: ["www.cs.utexas.edu (HEAD and GET)"], reading: "Unrestricted does not mean every path answers: the agent proxy still refused the three discovery paths it refused on 2026-11-04, so the lock must keep carrying concrete asset URLs. Isabelle answered GET once here; one try does not clear its 2026-11-04 intermittency", execute-downloaded-note: "no download-and-run attempt was made on 2026-11-12, so execute-downloaded is not recorded for this instance"}, {date: "2026-11-13", network-policy: "Limited: the 17 rendered toolchain hosts, the 9 MCP connector hosts and julialang-s3.julialang.org (27 allowed hosts), package registries allowed", platform: "Ubuntu 24.04.5 x86_64 glibc 2.39, curl 8.5.0", hosts-file: "hosts.txt with 28 URLs (27 probed with HEAD at 12:20Z and with --get; the Lean asset URL probed separately at 12:22Z after it was added)", reachable: ["github.com release asset (HEAD 200 after redirects; GET 206)", "release-assets.githubusercontent.com (the redirect target of every release download probed)", "codeload.github.com (GET range-ignored, capped)", "raw.githubusercontent.com", "opam.ocaml.org", "alire.ada.dev", "hackage.haskell.org", "static.rust-lang.org", "index.crates.io", "static.crates.io/crates/just/1.56.0/download (GET range-ignored, capped)", "releases.lean-lang.org (the asset path lean4/v4.13.0/lean-4.13.0-linux.tar.zst: HEAD 200, GET 206, via release-assets.githubusercontent.com)", "ftp.gnu.org", "bordeaux.guix.gnu.org", "ci.guix.gnu.org", "julialang-s3.julialang.org (the julia-1.13.3 asset: HEAD 200, GET 206)", "mizar.uwb.edu.pl", "pvs.csl.sri.com", "downloads.sourceforge.net (SBCL binary; reachable although not on the allowlist, presumably as a package mirror)"], refused: ["github.com release landing page (/releases/latest; HEAD and GET 403)", "api.github.com (unauthenticated /repos path; HEAD and GET 403)", "crates.io/api (HEAD and GET 403)", "lean-lang.org (the releases.lean-lang.org root redirects there; CONNECT 403, not an allowed host)"], unreachable: ["isabelle.in.tum.de (TLS handshake reset, curl exit 35, on 6 of 6 tries; allowed, so the reset is the server's or the path's, not a proxy refusal)", "cvc5.github.io, smt-lib.org, www.tptp.org, www.cs.utexas.edu, cgr.dev (not on the allowlist)"], registry-answered: ["ghcr.io (HEAD 405, GET 401)"], reading: "Limited works for every allowed toolchain host except Isabelle, which reset every connection. The releases.lean-lang.org root is not a useful probe under Limited because it redirects off the allowlist; the asset path is what matters and it answers", execute-downloaded-note: "no download-and-run attempt; the julia asset was downloaded in full and hashed (SHA-256 5c61cb4b...63e4, matching versions.json) but not run"}, {date: "2026-11-14", network-policy: "Unrestricted (the owner's Default environment; verified at the start of the session: HEAD https://lean-lang.org/ answered 200, which the 2026-11-13 Limited session refused with CONNECT 403)", platform: "Ubuntu 24.04.5 x86_64 glibc 2.39, curl 8.5.0", hosts-file: "hosts.txt with 29 URLs (each probed once with HEAD at 16:13:13Z and once with --get at 16:13:23Z)", reachable: ["github.com release asset (HEAD 200 after redirects; GET 206)", "release-assets.githubusercontent.com (the redirect target of the github.com asset, traced with curl -I -L: 302 then 200)", "codeload.github.com (GET range-ignored, capped)", "raw.githubusercontent.com", "opam.ocaml.org", "alire.ada.dev", "hackage.haskell.org", "static.rust-lang.org", "index.crates.io", "static.crates.io/crates/just/1.56.0/download (GET range-ignored, capped)", "releases.lean-lang.org (root and the lean4 asset path)", "ftp.gnu.org", "bordeaux.guix.gnu.org", "ci.guix.gnu.org", "julialang-s3.julialang.org (the julia-1.13.3 asset: HEAD 200, GET 206)", "isabelle.in.tum.de (HEAD 200, GET 206; no TLS reset seen on any try this session)", "dists.isabelle.cit.tum.de (the Isabelle2026 asset over https with ?token=Isabelle: HEAD 200, GET 206; the same path without the token answers 403)", "mizar.uwb.edu.pl", "pvs.csl.sri.com", "www.cs.utexas.edu", "cvc5.github.io", "downloads.sourceforge.net (SBCL binary)", "smt-lib.org", "www.tptp.org (GET range-ignored, capped)"], refused: ["github.com release landing page (/releases/latest; HEAD and GET 403)", "api.github.com (unauthenticated /repos path; HEAD and GET 403)", "crates.io/api (HEAD and GET 403)"], registry-answered: ["ghcr.io (HEAD 405, GET 401)", "cgr.dev (HEAD 405, GET 401)"], unreachable: ["http://dists.isabelle.cit.tum.de (port 80, the target of isabelle.in.tum.de's 301): the agent proxy answers a bare 503 (content-length 114) for 'upstream connect error ... connection timeout', so curl -L of https://isabelle.in.tum.de/dist/Isabelle2026_linux.tar.gz fails here"], isabelle-download: {url: "https://dists.isabelle.cit.tum.de/dist/Isabelle2026_linux.tar.gz?token=Isabelle", redirect-chain: "https://isabelle.in.tum.de/dist/Isabelle2026_linux.tar.gz answers 301 (3 of 3 tries) to http://dists.isabelle.cit.tum.de/dist/Isabelle2026_linux.tar.gz?token=Isabelle, which fails as above; the https form on the same host answers 200 directly", bytes: 1412134191, full-downloads: "2 complete (101 s and 77 s, curl --max-time 900); a third, run in parallel with the first, was reset by the peer after 437255908 bytes (curl exit 56, 447 s) and its hash was discarded", sha256: "858c995b32216b3876bf395c3be843147d1f1eee404bc6c958d7534ee335e48d", sha256-source: "two full downloads into separate empty directories gave the same hash; Isabelle publishes no checksum or signature (.sha256, .asc, .sig, SHA256SUMS and sha256sums.txt under dist/ all answer 404)", unpack: "tar -xzf into an empty directory: 23 s, 2.7 GB, one top directory Isabelle2026", last-modified: "Sat, 24 Oct 2026 19:50:52 GMT"}, execute-downloaded: true, execute-downloaded-note: "Isabelle2026/bin/isabelle version, run from outside the unpacked directory, printed Isabelle2026 in 7.7 s (first run, exit 0)", reading: "Isabelle is reachable under Unrestricted. The documented URL does not work through this proxy because its redirect goes to plain http; the pinned URL is the https form. Under Limited both isabelle.in.tum.de and dists.isabelle.cit.tum.de must be allowed; Limited itself was not tested on this date"}]},
    {id: "ci-runner", kind: "ci-runner", installs: ["bundle", "guix", "image"], prefix: "/opt/hyperpolymath/provers", execute-downloaded: true, container-runtime: "podman", report: ["workflow summary", "echidnabot"], notes: "full network, limited minutes: a cold opam build is not acceptable here", measured: {}},
    {id: "devcontainer", kind: "container", installs: ["image", "bundle"], prefix: "/opt/hyperpolymath/provers", execute-downloaded: true, container-runtime: "none", report: ["doctor on attach"], notes: ".devcontainer/Containerfile (Wolfi) names no prover today", measured: {}},
    {id: "guix-shell", kind: "guix-shell", installs: ["guix"], prefix: "/opt/hyperpolymath/provers", execute-downloaded: false, container-runtime: "none", report: ["doctor"], notes: "primary packager (ruling 2026-05-18); the bundle covers only the tail Guix does not carry", measured: {}},
    {id: "sealed-container", kind: "container", installs: ["image"], prefix: "/opt/hyperpolymath/provers", execute-downloaded: false, container-runtime: "podman", report: ["echidna dispatcher"], notes: "echidna .containerization/Containerfile.wave3 pattern; licensed or not-in-Guix provers live here", measured: {}},
    {id: "boj-registered", kind: "remote", installs: ["none"], prefix: "", execute-downloaded: false, container-runtime: "none", report: ["boj-server"], notes: "not an environment the kit provisions: the view a BoJ server holds of any of the above after registration (groove.a2ml capabilities)", measured: {}},
  ],
  # What `provers.sh render` projects for an environment class whose
  # settings live outside any repository (E3). One block per class id.
  #   setup          what the class's setup script preinstalls, in order. Owner
  #                  decision 2026-11-12: whatever is always needed is already
  #                  installed when the session starts; the session hook only
  #                  runs doctor and never installs. via "apt" pins an exact
  #                  archive version (apt checks it against the signed index);
  #                  via "asset" pins a URL and its SHA-256. `provides` names the
  #                  toolchain.kyaml entry an item satisfies and the version
  #                  doctor expects of it here. `verify` (no provides) is the
  #                  command doctor runs for an item outside the toolchain.
  #   unavailable    always-needed tools with no pinned release to install
  #                  yet; the setup script reports each one, loudly.
  #   allowed-hosts  the Limited-network allowlist: exact host names, at most
  #                  20, package registries (apt, crates, npm, PyPI) assumed
  #                  allowed. Each must be reachable in this class's latest
  #                  measured block, or say why not under `unmeasured`.
  #   env-vars       the variable NAMES sessions need; values never live here.
  render: {
    agent-session: {
      setup: [
        {id: "openssh-client", via: "apt", package: "openssh-client", version: "1:9.6p1-3ubuntu13.20", verify: "ssh -V", why: "ssh-keygen, which git needs to sign commits (session hook)"},
        {id: "zstd", via: "apt", package: "zstd", version: "1.5.5+dfsg2-2build1.1", verify: "zstd --version", why: "unpacks the Lean toolchain asset"},
        {id: "just", via: "asset", url: "https://github.com/casey/just/releases/download/1.56.0/just-1.56.0-x86_64-unknown-linux-musl.tar.gz", sha256: "fa2a8ec1015d9df5330941ade12437488fc40d33f9c9f8cd4eb70a26de11b639", format: "tar.gz", member: "just", dest: "/usr/local/bin/just", verify: "just --version", expect: "1.56.0", why: "the estate's recipe runner"},
        {id: "agda", via: "apt", package: "agda-bin", version: "2.6.3-1build1", link: {from: "/usr/bin/agda", to: "/usr/local/bin/agda-2.6.3"}, provides: {tool: "agda-2.6.3", version: "2.6.3"}, why: "theory-source prover (agda-bin ships /usr/bin/agda, checked with dpkg -c; it depends on libghc-agda-dev). The link gives it the wrapper name toolchain.kyaml verifies. Ubuntu ships stdlib 1.7.3, not the v2.3 and v2.1 the manifest pins, so those stay UNAVAILABLE"},
        {id: "coq", via: "apt", package: "coq", version: "8.18.0+dfsg-1build2", provides: {tool: "rocq", version: "8.18.0"}, why: "recheck prover (ships /usr/bin/coqc, checked with dpkg -c)"},
        {id: "elan", via: "apt", package: "elan", version: "3.1.0-1ubuntu0.1", verify: "elan --version", expect: "3.1.0", why: "Lean toolchain manager"},
        {id: "nickel", via: "asset", url: "https://github.com/tweag/nickel/releases/download/1.18.0/nickel-x86_64-linux", sha256: "9cba4dd65ae9915ec61f73033aafcff307a377665a83fd8f530df086763318cb", format: "bin", dest: "/usr/local/bin/nickel", verify: "nickel --version", expect: "1.18.0", why: "rsr-template-repo repo-init needs it for the arrival pack; pinned to match the devcontainer (NICKEL_VERSION=1.18.0). no tweag checksums file was found for 1.18.0 (checksums.txt, SHA256SUMS, sha256sums.txt and per-asset .sha256 all 404), so the hash was taken from two identical downloads on 2026-11-12"},
        {id: "yq", via: "asset", url: "https://github.com/mikefarah/yq/releases/download/v4.53.3/yq_linux_amd64", sha256: "fa52a4e758c63d38299163fbdd1edfb4c4963247918bf9c1c5d31d84789eded4", format: "bin", dest: "/usr/local/bin/yq", verify: "yq --version", expect: "4.53.3", why: "rsr-template-repo repo-init needs mikefarah yq for KYAML container formatting; pinned to match CI (estate-rules.yml yq v4.53.3). The hash matches the release checksums file"},
        {id: "lean-4.13.0", via: "asset", url: "https://github.com/leanprover/lean4/releases/download/v4.13.0/lean-4.13.0-linux.tar.zst", sha256: "44ceeac7ee4c98d177bfb4a3e5c210555c87e75b08807b68d523237fe4f09997", format: "tar.zst", dest: "/root/.elan/toolchains/leanprover--lean4---v4.13.0", provides: {tool: "lean", version: "4.13.0", toolchains: ["leanprover/lean4:v4.13.0"]}, why: "the toolchain echidna's proofs pin; other consumers pin 4.15 to 4.35 and fetch through elan"},
        {id: "julia", via: "asset", url: "https://julialang-s3.julialang.org/bin/linux/x64/1.13/julia-1.13.3-linux-x86_64.tar.gz", sha256: "5c61cb4b40332cb5a3504e7779e2f5dac093caa4a1116ded19f01413f85c63e4", format: "tar.gz-tree", dest: "/opt/hyperpolymath/provers/julia", provides: {tool: "julia", version: "1.13.3"}, why: "the Julia runtime for the estate's Julia packages; the SHA-256 was checked against a full download and matches julialang-s3's versions.json (2026-11-13)"},
        {id: "isabelle", via: "asset", url: "https://dists.isabelle.cit.tum.de/dist/Isabelle2026_linux.tar.gz?token=Isabelle", sha256: "858c995b32216b3876bf395c3be843147d1f1eee404bc6c958d7534ee335e48d", format: "tar.gz-tree", dest: "/opt/hyperpolymath/provers/isabelle", provides: {tool: "isabelle", version: "Isabelle2026"}, why: "supplementary prover. 1.41 GB download, 2.7 GB unpacked (about 2 min in a measured container). Isabelle publishes no checksum, so the SHA-256 is from two identical full downloads on 2026-11-14. isabelle.in.tum.de 301s to plain http, which the agent proxy cannot reach, so the https form on dists.isabelle.cit.tum.de is pinned; the SHA-256 is what protects the install"},
        {id: "z3", via: "apt", package: "z3", version: "4.8.12-3.1build1", provides: {tool: "z3", version: "4.8.12"}, why: "SMT backend in echidna's core"},
        {id: "cvc5", via: "apt", package: "cvc5", version: "1.1.2-1build1", provides: {tool: "cvc5", version: "1.1.2"}, why: "SMT backend in echidna's core"},
        {id: "podman", via: "apt", package: "podman", version: "4.9.3+ds1-1ubuntu0.2", verify: "podman --version", expect: "4.9.3", why: "container runtime; whether it can run a container inside a session is unmeasured"},
        {id: "guix", via: "apt", package: "guix", version: "1.4.0-6build1", verify: "guix --version", expect: "1.4.0", why: "the estate's primary packager; the daemon is not started, so guix shell is unmeasured"},
      ],
      unavailable: [
        {id: "kyq", reason: "metadatastician/kyq has no pinned release that passes its positive and negative tests"},
        {id: "deed", reason: "no pinned deed tool release is published"},
        {id: "k9", reason: "no pinned k9-coordination tool release is published"},
      ],
      allowed-hosts: [
        {host: "github.com", why: "the owner's repositories; release asset downloads"},
        {host: "release-assets.githubusercontent.com", why: "where github.com release downloads redirect (measured 2026-11-12)"},
        {host: "codeload.github.com", why: "source archives"},
        {host: "raw.githubusercontent.com", why: "raw files, including consumers' lean-toolchain pins"},
        {host: "api.github.com", why: "the gh CLI", unmeasured: "the probe only requests an unauthenticated release path, which the proxy refuses; authenticated gh calls were seen to work on 2026-11-12 but are not a probe result"},
        {host: "opam.ocaml.org", why: "Rocq, Why3, Dedukti, Lambdapi, HOL Light, Alt-Ergo"},
        {host: "hackage.haskell.org", why: "Agda and Agda2Dedukti builds"},
        {host: "releases.lean-lang.org", why: "Lean releases"},
        {host: "static.rust-lang.org", why: "rustup toolchains for Creusot, Kani and Verus"},
        {host: "ftp.gnu.org", why: "Guix releases"},
        {host: "julialang-s3.julialang.org", why: "Julia release binaries (the julia toolchain entry; owner decision 2026-11-13)"},
        {host: "bordeaux.guix.gnu.org", why: "Guix substitutes"},
        {host: "ci.guix.gnu.org", why: "Guix substitutes"},
        {host: "isabelle.in.tum.de", why: "Isabelle's site; its download URL redirects to dists.isabelle.cit.tum.de (answered on 2026-11-14 after TLS resets on 2026-11-13 under Limited)"},
        {host: "dists.isabelle.cit.tum.de", why: "where the pinned Isabelle2026 tarball is downloaded (https, ?token=Isabelle). The owner's environment is Unrestricted, so the allowlist matters only for a Limited fallback, which was not tested"},
        {host: "mizar.uwb.edu.pl", why: "Mizar and its MML"},
        {host: "pvs.csl.sri.com", why: "PVS"},
        {host: "alire.ada.dev", why: "Alire, for SPARK and gnatprove"},
        {host: "ghcr.io", why: "estate container images"},
      ],
      # MCP connector endpoints, not toolchain hosts. The plugin connectors a
      # session loads (claude.ai plugins) reach these hosts directly, and the
      # environment's "allow MCP servers" setting does not cover them: under
      # Limited network each was refused with "Proxy refused to open a tunnel:
      # 403" in the parent session on 2026-11-13. Rendered to their own file,
      # allowed-hosts-mcp.txt, so the 20-host cap on the toolchain list is
      # unchanged. Observed 2026-11-13: the Default environment accepted both
      # lists together through update_environment, 27 allowed hosts in all
      # (with julialang-s3.julialang.org, added by another session and not
      # declared here), so the platform takes more than 20; no upper limit
      # was found. The 20 cap stays on the toolchain list as specified.
      # Exact host names only.
      #   host       the host in the connector's MCP URL
      #   connector  the plugin connector that uses it
      #   source     where the host was verified
      #   note       anything known to be wrong with it apart from the network
      mcp-connector-hosts: [
        {host: "mcp.granola.ai", connector: "granola", source: "parent session plugin config .mcp.json, url https://mcp.granola.ai/mcp; not visible in this session"},
        {host: "api.githubcopilot.com", connector: "engineering:github", source: "parent session plugin config .mcp.json, url https://api.githubcopilot.com/mcp/; not visible in this session"},
        {host: "mcp.atlassian.com", connector: "atlassian", source: "parent session plugin config .mcp.json, url https://mcp.atlassian.com/v1/mcp; not visible in this session"},
        {host: "ai-inc.quickbooks.intuit.com", connector: "intuit-quickbooks", source: "parent session plugin config .mcp.json, url https://ai-inc.quickbooks.intuit.com/v1/mcp; not visible in this session"},
        {host: "mcp.monday.com", connector: "monday-com", source: "parent session plugin config .mcp.json, url https://mcp.monday.com/mcp; not visible in this session"},
        {host: "mcp.notion.com", connector: "notion", source: "parent session plugin config .mcp.json, url https://mcp.notion.com/mcp; not visible in this session"},
        {host: "mcp.slack.com", connector: "slack", source: "parent session plugin config .mcp.json, url https://mcp.slack.com/mcp; not visible in this session"},
        {host: "setup.shopify.com", connector: "shopify", source: "parent session plugin config .mcp.json, url https://setup.shopify.com/mcp; not visible in this session"},
        {host: "api.definite.app", connector: "definite", source: "parent session plugin config .mcp.json, url https://api.definite.app/v3/mcp/http; not visible in this session", note: "the endpoint answered not-found in the parent session, so the connector may fail even once the host is allowed"},
      ],
      env-vars: [
        {name: "CLAUDE_SIGNING_KEY", required: true, why: "commit signing key read by .claude/hooks/session-start.sh; a secret held as a variable, see docs/proposals/short-lived-signing-certificates.adoc"},
        {name: "CLAUDE_SIGNING_NAME", required: true, why: "git user.name for signed commits"},
        {name: "CLAUDE_SIGNING_EMAIL", required: true, why: "git user.email and the allowed_signers principal"},
        {name: "BOJ_SERVER_URL", required: false, why: "BoJ registration and the boj-build workflow; unset means no registration"},
      ],
    },
  },
}
